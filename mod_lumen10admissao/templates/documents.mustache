    @template mod_lumen10admissao/documents
    Context: documents with label, size, url and mime.
    Example context (json): {"documents":[{"label":"Identity document","size":"12 KB","url":"#","mime":"application/pdf"}]}
}}
<h3>{{#str}}documentsheading, mod_lumen10admissao{{/str}}</h3>
{{#documents}}
<p>{{label}} · {{size}} <a href="{{url}}" class="btn btn-sm btn-outline-primary l10adm-preview" data-mime="{{mime}}" data-label="{{label}}">{{#str}}viewdocument, mod_lumen10admissao{{/str}}</a></p>
{{/documents}}
<dialog class="l10adm-dialog" aria-labelledby="l10adm-dialog-title">
    <div class="l10adm-dialog-head"><strong id="l10adm-dialog-title"></strong><button type="button" class="btn btn-secondary" aria-label="{{#str}}closedocument, mod_lumen10admissao{{/str}}">×</button></div>
    <div class="l10adm-dialog-body"></div>
</dialog>
