<div class="l10adm">
    <h2>{{title}}</h2>
    {{#haslinks}}
    <ul>
        {{#links}}
        <li><a href="{{url}}"{{#hidden}} class="dimmed_text"{{/hidden}}>{{{name}}}</a></li>
        {{/links}}
    </ul>
    {{/haslinks}}
    {{^haslinks}}<p>{{#str}}noactivities, mod_lumen10admissao{{/str}}</p>{{/haslinks}}
</div>
